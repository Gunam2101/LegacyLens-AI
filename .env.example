# LegacyLens AI Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application
PROJECT_NAME="LegacyLens AI"
VERSION="1.0.0"

# AI Inference Engine Provider: 'auto', 'gemini', 'openai', or 'local_heuristic'
# Default 'auto' uses Gemini or OpenAI if keys are present, else runs built-in deterministic AST correlator out-of-the-box
AI_PROVIDER="auto"

# Google Gemini (Optional for cloud LLM reasoning)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI (Optional alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Security & Workspace Limits
MAX_UPLOAD_MB=100
MAX_EXTRACTED_MB=500
MAX_FILE_COUNT=3000
SANDBOX_TIMEOUT_SEC=30

# Database (Default uses local SQLite in storage/legacylens.db)
# DATABASE_URL="postgresql://user:password@localhost:5432/legacylens"
